# Copy this file to .env and fill in real values. NEVER commit .env.

# --- LLM providers ---
OPENAI_API_KEY=
GEMINI_API_KEY=
# HF_TOKEN=

# --- Admin login (generate with: python scripts/make_admin_credentials.py) ---
ADMIN_USERNAME=admin
# Keep the single quotes: the bcrypt hash contains '$' characters
ADMIN_PASSWORD_HASH=''
# Long random string used to sign login tokens
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS: comma-separated frontend origins allowed to call the API ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
